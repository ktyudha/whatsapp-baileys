APP_NAME=whatsapp-baileys
NODE_ENV=development #production|development
LOG_LEVEL=debug #debug|info|warn|error
PORT=2881

WA_AUTH_DIR=auth_info_baileys
WA_PAIRING_NUMBER= #628xxxxxxxxxx, leave empty to use QR code
WA_RECONNECT_DELAY_MS=3000
WA_BROWSER_PLATFORM=ubuntu #ubuntu|macOS|windows|baileys|appropriate
WA_MARK_ONLINE_ON_CONNECT=false #true|false
WA_SYNC_FULL_HISTORY=false #true|false
WA_IGNORE_BROADCAST=true #true|false
WA_MAX_MSG_RETRY_COUNT=5
WA_CONNECT_TIMEOUT_MS=20000
WA_QUERY_TIMEOUT_MS=60000
WA_KEEP_ALIVE_INTERVAL_MS=30000
WA_MESSAGE_CACHE_TTL_S=3600
WA_GROUP_CACHE_TTL_S=300

WA_AUTO_REPLY_ENABLED=true #true|false
WA_AUTO_REPLY_MESSAGE=Hello from Baileys!

WA_FORWARD_ENABLED=false #true|false
WA_FORWARD_SOURCE_WHITELIST= #comma separated jids, e.g. 6281234567890@s.whatsapp.net,123456789-123345@g.us
WA_FORWARD_TARGET_JIDS= #comma separated jids to forward to, e.g. 123456789-123345@g.us

WA_REJECT_CALLS=false #true|false

WA_REDIRECT_GROUP_ID= #group jid, e.g. 123456789-123345@g.us. Private messages are forwarded here; leave empty to disable
WA_REDIRECT_MAP_TTL_S=86400 #how long a group reply can still be routed back to the original sender

WA_COMMAND_PREFIX=!
WA_COMMAND_ADMIN_JIDS= #comma separated jids allowed to run bot commands, e.g. 6281234567890@s.whatsapp.net. Leave empty to disable all commands
